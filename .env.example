# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.

ENV=dev
LOG_LEVEL=INFO

# Matches the `db` service in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://widget_platform:widget_platform@db:5432/widget_platform
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-48-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Add every origin your "customer site" test pages run on
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

SUBMISSION_RATE_LIMIT_PER_IP=5/minute
SUBMISSION_RATE_LIMIT_PER_WIDGET=60/minute

GEO_PROVIDER_A_URL=http://ip-api.com/json/{ip}
GEO_PROVIDER_B_URL=https://ipapi.co/{ip}/json/
GEO_PROVIDER_TIMEOUT_SECONDS=2.0
# Demo aid only — flip to true + restart to reliably show the fallback chain
# live without depending on a real ip-api.com outage. Always false otherwise.
GEO_PROVIDER_A_FORCE_FAIL=true

NOTIFY_BACKEND=console
NOTIFY_WEBHOOK_URL=
# Demo aid only — flip to true + restart to reliably show a submission
# succeeding despite a failing notification. Always false otherwise.
NOTIFY_FORCE_FAIL=false
